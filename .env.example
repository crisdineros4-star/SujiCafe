# Copy this file to .env and fill in your own values.
SECRET_KEY=replace-with-a-long-random-secret
DB_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=suji_cafe
# For Gmail use an App Password; generic authenticated SMTP is also supported.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
GMAIL_USER=
GMAIL_APP_PASSWORD=
GOOGLE_CLIENT_ID=
# Reserved owner email. Create the account with: flask --app app create-owner
ADMIN_EMAIL=
DEV_PRINT_OTP=0

STORE_NAME=Suji Cafe
STORE_ADDRESS=10384 Diamond St., Umali Subdivision, Batong Malake, Los Baños, Laguna 4030, Philippines
# Map centre only. Set verified store coordinates before enabling a store pin.
STORE_LAT=14.1667
STORE_LNG=121.2333
FACEBOOK_URL=https://www.facebook.com/sujistreetcafe/
INSTAGRAM_URL=https://www.instagram.com/sujicafe_/
GOOGLE_MAPS_URL=https://www.google.com/maps/search/?api=1&query=10384+Diamond+St.%2C+Umali+Subdivision%2C+Batong+Malake%2C+Los+Ba%C3%B1os%2C+Laguna+4030%2C+Philippines
FLASK_DEBUG=0
HTTPS=0

STORE_COORDINATES_VERIFIED=0

# Owner email; legacy ADMIN_EMAIL is used only when OWNER_EMAIL is absent.
OWNER_EMAIL=

# Required for employee invitation emails: your actual HTTPS website origin.
# For same-computer development only: http://127.0.0.1:5000
PUBLIC_BASE_URL=

# Production security: keep development for localhost testing only.
APP_ENV=development
# Production: APP_ENV=production, HTTPS=1, a random SECRET_KEY (32+ chars),
# FLASK_DEBUG=0, DEV_PRINT_OTP=0 and PUBLIC_BASE_URL=https://your-real-host
# Comma-separated hostnames; defaults to localhost/127.0.0.1 in development.
ALLOWED_HOSTS=
# Use 1 ONLY behind one reverse proxy which replaces forwarded headers,
# blocks direct backend access and terminates trusted HTTPS. Otherwise keep 0.
TRUSTED_PROXY_HOPS=0

# Remote production MySQL requires a trusted CA file; leave empty for local MySQL.
MYSQL_SSL_CA=
